# Configuración de Base de Datos PostgreSQL
DB_USER=avnadmin
DB_PASSWORD=tu_contraseña_aqui
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bdanime
DB_SSLMODE=disable

# Opcional: URL completa de conexión (si se define, tiene prioridad sobre los campos individuales)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/bdanime?sslmode=disable

# Configuración de Seguridad y JWT
JWT_SECRET_KEY=clave_secreta_para_firmar_tokens_jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Configuración de CORS (separados por coma o * para todos)
CORS_ORIGINS=*
